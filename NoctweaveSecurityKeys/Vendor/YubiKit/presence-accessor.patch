+    // Noctweave addition: resolve the actual open handle, never a name or vendor match.
+    func registryEntryID(for locationID: Int) async throws(FIDOConnectionError) -> UInt64 {
+        try await runloop.perform { () -> Result<UInt64, FIDOConnectionError> in
+            guard let state = self.openConnections[locationID] else { return .failure(.connectionLost) }
+            var identity: UInt64 = 0
+            guard IORegistryEntryGetRegistryEntryID(IOHIDDeviceGetService(state.device), &identity) == KERN_SUCCESS,
+                  identity != 0 else { return .failure(.connectionLost) }
+            return .success(identity)
         }
     }
 
