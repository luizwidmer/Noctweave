{
  "name": "@noctweave/relay-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Source-built desktop operator launcher for NoctweaveRelayServer.",
  "type": "module",
  "scripts": {
    "desktop:dev": "bun desktop/scripts/run-electrobun.ts dev",
    "desktop:watch": "bun desktop/scripts/run-electrobun.ts dev --watch",
    "desktop:build": "bun desktop/scripts/build-desktop.ts",
    "desktop:prepare": "bun node_modules/electrobun/bin/electrobun.cjs prepare --env=stable",
    "desktop:icons": "bun desktop/scripts/generate-icons.ts",
    "desktop:test": "bun test desktop/test desktop/checks",
    "typecheck:desktop": "tsc --noEmit"
  },
  "license": "AGPL-3.0-or-later",
  "engines": {
    "bun": ">=1.3.0"
  },
  "overrides": {
    "ip-address": "10.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.3.14",
    "@types/three": "^0.185.1",
    "electrobun": "2.0.2",
    "png2icons": "^2.0.1",
    "typescript": "^7.0.2"
  }
}
