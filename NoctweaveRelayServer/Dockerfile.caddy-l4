FROM caddy:2-builder@sha256:c4cd20eaa0b69112fd5d4f721ffc9671687e1d5d0b155c8620cf7546dbef94c0 AS builder
COPY CaddyPatches/go-jose-v3-rsa-limit.patch /tmp/go-jose-v3-rsa-limit.patch
COPY CaddyPatches/go-jose-v3-rsa-limit_test.go /tmp/go-jose-v3-rsa-limit_test.go
COPY CaddyPatches/go-jose-v3-json-depth_test.go /tmp/go-jose-v3-json-depth_test.go
COPY CaddyPatches/go-jose-v3-cbc-hmac_test.go /tmp/go-jose-v3-cbc-hmac_test.go
RUN apk upgrade --no-cache \
    && apk add --no-cache patch \
    && go install github.com/caddyserver/xcaddy/cmd/xcaddy@v0.4.7 \
    && go mod download github.com/go-jose/go-jose/v3@v3.0.5 \
    && cp -R /go/pkg/mod/github.com/go-jose/go-jose/v3@v3.0.5 /opt/noctweave-go-jose-v3 \
    && chmod -R u+w /opt/noctweave-go-jose-v3 \
    && patch --batch --fuzz=0 -p1 -d /opt/noctweave-go-jose-v3 < /tmp/go-jose-v3-rsa-limit.patch \
    && cp /tmp/go-jose-v3-rsa-limit_test.go /opt/noctweave-go-jose-v3/noctweave_rsa_limit_test.go \
    && cp /tmp/go-jose-v3-json-depth_test.go /opt/noctweave-go-jose-v3/json/noctweave_json_depth_test.go \
    && cp /tmp/go-jose-v3-cbc-hmac_test.go /opt/noctweave-go-jose-v3/cipher/noctweave_cbc_hmac_test.go \
    && (cd /opt/noctweave-go-jose-v3 && go test -count=1 . ./json ./cipher) \
    && xcaddy build v2.11.7 \
    --with github.com/mholt/caddy-l4@v0.1.2 \
    --replace github.com/go-jose/go-jose/v3=/opt/noctweave-go-jose-v3 \
    --replace github.com/go-jose/go-jose/v4=github.com/go-jose/go-jose/v4@v4.1.6 \
    --replace github.com/go-chi/chi/v5=github.com/go-chi/chi/v5@v5.4.0 \
    --replace golang.org/x/crypto=golang.org/x/crypto@v0.58.0 \
    --replace golang.org/x/net=golang.org/x/net@v0.62.0 \
    --replace golang.org/x/text=golang.org/x/text@v0.43.0 \
    --replace google.golang.org/grpc=google.golang.org/grpc@v1.84.0

FROM caddy:2@sha256:36c24ad91a7ff7bc4c87fe22bfa8df3c4b18da0773d73fc12ee2c52b98c0bb7e
RUN apk upgrade --no-cache \
    && apk add --no-cache 'brotli-libs>=1.2.1-r0' c-ares curl libcurl \
    && addgroup -S -g 10003 noctweave-caddy \
    && adduser -S -D -u 10003 -G noctweave-caddy -h /home/noctweave-caddy noctweave-caddy \
    && mkdir -p /config /data \
    && chown -R noctweave-caddy:noctweave-caddy /config /data
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
USER noctweave-caddy:noctweave-caddy
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["curl", "--fail", "--silent", "--show-error", "http://127.0.0.1:2019/config/"]
