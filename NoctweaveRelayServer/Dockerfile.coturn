FROM coturn/coturn:4.18.0-r0-alpine@sha256:c29135c08565810d37053f384584392b7c24b69570fc81a721b878d6fe63e04e

USER root
RUN apk upgrade --no-cache \
    && apk add --no-cache 'brotli-libs>=1.2.1-r0' bind-libs bind-tools
USER nobody:nogroup
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["sh", "-c", "test \"$(cat /proc/1/comm)\" = turnserver"]
